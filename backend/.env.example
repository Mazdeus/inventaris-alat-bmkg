# Konfigurasi Database MySQL
DATABASE_URL=mysql+mysqlconnector://root:password@localhost:3306/inventaris_bmkg

# Konfigurasi Keamanan & Token JWT
SECRET_KEY=ganti_dengan_random_string_aman_minimal_32_karakter_contoh_d83fa9012bcfe87
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Mode Debug (true untuk development, false untuk production)
DEBUG=true

# URL Basis Backend (untuk akses asset upload)
BASE_URL=http://localhost:8000

# ==============================================================================
# Konfigurasi Notifikasi Email (SMTP Gmail / Mail Server)
# ==============================================================================
# Aktifkan (true) atau nonaktifkan (false) fitur pengiriman email notifikasi
SMTP_ENABLED=true

# Host server SMTP pengirim (contoh: smtp.gmail.com untuk Google Mail)
SMTP_HOST=smtp.gmail.com

# Port koneksi SMTP (587 untuk TLS/STARTTLS, 465 untuk SSL)
SMTP_PORT=587

# Alamat email akun pengirim yang digunakan untuk login SMTP
SMTP_USER=email_pengirim@gmail.com

# 16 digit Sandi Aplikasi Google (App Password) akun pengirim
SMTP_PASSWORD=ganti_dengan_16_digit_app_password

# Alamat email yang tampil sebagai identitas pengirim (Header From)
SMTP_FROM_EMAIL=email_pengirim@gmail.com

# Nama instansi / label pengirim yang tampil pada inbox penerima
SMTP_FROM_NAME="Sistem Inventaris BMKG"

# Gunakan enkripsi STARTTLS (wajib true untuk port 587)
SMTP_TLS=true

# Gunakan enkripsi SSL langsung (wajib false jika menggunakan port 587 TLS)
SMTP_SSL=false

# ==============================================================================
# Jadwal Cron Pemindaian Otomatis Jatuh Tempo Peminjaman
# ==============================================================================
# Jam eksekusi pemindaian harian (format 24 jam, contoh: 8 untuk pukul 08:00 WIB)
EMAIL_REMINDER_CRON_HOUR=8

# Menit eksekusi pemindaian harian (contoh: 0 untuk menit ke-00)
EMAIL_REMINDER_CRON_MINUTE=0
